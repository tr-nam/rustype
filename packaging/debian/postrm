#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Update desktop database
        if which update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi

        # Update GTK icon cache
        if which gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
        fi

        # Đưa unit IBus của GNOME về ibus-daemon cho mọi người dùng đang đăng nhập: nạp lại
        # systemd và khởi động lại không chờ. Mỗi lệnh có timeout, nhận stdin từ /dev/null, và lỗi
        # không làm hỏng gói. RUSTYPE_RUNTIME_ROOT chỉ dùng để thử nghiệm.
        runtime_root="${RUSTYPE_RUNTIME_ROOT:-/run/user}"
        for bus in "$runtime_root"/*/bus; do
            [ -e "$bus" ] || continue
            uid=$(basename "$(dirname "$bus")")
            case "$uid" in ''|*[!0-9]*) continue ;; esac
            [ "$uid" -ge 1000 ] 2>/dev/null || continue
            name=$(getent passwd "$uid" 2>/dev/null | cut -d: -f1) || continue
            [ -n "$name" ] || continue
            runuser -u "$name" -- env XDG_RUNTIME_DIR="$runtime_root/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_root/$uid/bus" timeout 20 systemctl --user daemon-reload </dev/null >/dev/null 2>&1 || true
            runuser -u "$name" -- env XDG_RUNTIME_DIR="$runtime_root/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_root/$uid/bus" timeout 20 systemctl --user --no-block restart org.freedesktop.IBus.session.GNOME.service </dev/null >/dev/null 2>&1 || true
        done
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
