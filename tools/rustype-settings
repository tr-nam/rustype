    def notify(self, message: str, button_label: str = None, callback=None):
        """Displays a clean in-app toast notification."""
        toast = Adw.Toast.new(message)
        if button_label and callback:
            toast.set_button_label(button_label)
            toast.connect("button-clicked", callback)
        self.add_toast(toast)

    def on_method_changed(self, combo, _):
        self.cfg.input_method = "telex" if combo.get_selected() == 0 else "vni"
        self.cfg.save()

    def on_mode_changed(self, combo, _):
        idx = combo.get_selected()
        self.cfg.mode = "auto" if idx == 0 else ("preedit" if idx == 1 else "direct")
        self.cfg.save()

    def on_switch_changed(self, key, value):
        setattr(self.cfg, key, value)
        self.cfg.save()

    def refresh_macros(self):
        # Clear existing rows in macro group
        for k, v in sorted(self.cfg.macros.items()):
            row = Adw.ActionRow(title=k, subtitle=v, use_markup=False)
            btn_del = Gtk.Button(
                icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER
            )
            btn_del.connect("clicked", lambda _, key=k: self.delete_macro(key))
            row.add_suffix(btn_del)
            self.grp_macro_list.add(row)

    def delete_macro(self, key):
        self.cfg.macros.pop(key, None)
        self.cfg.save()
        self.notify("Đã xóa từ gõ tắt")

    def on_add_macro_clicked(self, _):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Thêm từ gõ tắt",
            body="Nhập từ viết tắt và nội dung mở rộng tương ứng.",
        )
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        e_key = Gtk.Entry(placeholder_text="Từ viết tắt (vd: vn)")
        e_val = Gtk.Entry(placeholder_text="Nội dung đầy đủ (vd: Việt Nam)")
        box.append(e_key)
        box.append(e_val)
        dialog.set_extra_child(box)

        dialog.add_response("cancel", "Hủy")
        dialog.add_response("add", "Thêm")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)

        def on_resp(d, resp):
            if resp == "add":
                k, v = e_key.get_text().strip(), e_val.get_text().strip()
                if k and v:
                    self.cfg.macros[k] = v
                    self.cfg.save()
                    self.notify(f"Đã thêm: {k} ➔ {v}")

        dialog.connect("response", on_resp)
        dialog.present()

    def refresh_words(self):
        for w in self.cfg.custom_words:
            row = Adw.ActionRow(title=w, use_markup=False)
            btn_del = Gtk.Button(
                icon_name="user-trash-symbolic", valign=Gtk.Align.CENTER
            )
            btn_del.connect("clicked", lambda _, word=w: self.delete_word(word))
            row.add_suffix(btn_del)
            self.grp_words.add(row)

    def delete_word(self, word):
        if word in self.cfg.custom_words:
            self.cfg.custom_words.remove(word)
            self.cfg.save()
            self.notify(f"Đã xóa từ: {word}")

    def on_add_word_clicked(self, _):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Thêm từ tiếng Anh ngoại lệ",
            body="Từ này sẽ được giữ nguyên không bao giờ bỏ dấu tiếng Việt.",
        )
        entry = Gtk.Entry(placeholder_text="Từ tiếng Anh (vd: github)")
        dialog.set_extra_child(entry)
        dialog.add_response("cancel", "Hủy")
        dialog.add_response("add", "Thêm")
        dialog.set_response_appearance("add", Adw.ResponseAppearance.SUGGESTED)

        def on_resp(d, resp):
            if resp == "add":
                w = entry.get_text().strip().lower()
                if w and w not in self.cfg.custom_words:
                    self.cfg.custom_words.append(w)
                    self.cfg.save()
                    self.notify(f"Đã thêm từ: {w}")

        dialog.connect("response", on_resp)
        dialog.present()

    def on_check_update_clicked(self, _):
        self.btn_check_update.set_sensitive(False)
        self.row_version.set_subtitle(
            f"v{self.version} • Đang kiểm tra bản cập nhật..."
        )

        def worker():
            try:
                url = "https://api.github.com/repos/namtr/rustype/releases/latest"
                req = urllib.request.Request(
                    url,
                    headers={"User-Agent": f"RustypeSettings/{self.version}"},
                )
                with urllib.request.urlopen(req, timeout=5) as resp:
                    if resp.status == 200:
                        data = json.loads(resp.read().decode("utf-8"))
                        tag = data.get("tag_name", "").lstrip("v").strip()
                        html_url = data.get(
                            "html_url", "https://github.com/namtr/rustype/releases"
                        )
                        GLib.idle_add(self._on_update_result, True, tag, html_url)
                        return
                GLib.idle_add(self._on_update_result, False, "HTTP error", "")
            except Exception as e:
                GLib.idle_add(self._on_update_result, False, str(e), "")

        threading.Thread(target=worker, daemon=True).start()

    def _on_update_result(self, success, tag_or_err, html_url):
        self.btn_check_update.set_sensitive(True)
        if not success:
            self.row_version.set_subtitle(
                f"v{self.version} • Không thể kiểm tra (Lỗi kết nối mạng)"
            )
            self.notify("Không thể kết nối đến máy chủ kiểm tra cập nhật.")
            return

        latest_tag = tag_or_err

        def parse_ver(v_str):
            try:
                clean = v_str.split("-")[0].split("+")[0]
                return tuple(int(x) for x in clean.split("."))
            except Exception:
                return (0, 0, 0)

        cur_v = parse_ver(self.version)
        lat_v = parse_ver(latest_tag)

        if lat_v > cur_v:
            self.row_version.set_subtitle(
                f"v{self.version} • Có bản mới: v{latest_tag}!"
            )
            self.notify(
                f"Đã có phiên bản mới: v{latest_tag}!",
                button_label="Tải về",
                callback=lambda *_: Gio.AppInfo.launch_default_for_uri(html_url, None),
            )
        else:
            self.row_version.set_subtitle(
                f"v{self.version} • Bạn đang sử dụng phiên bản mới nhất"
            )
            self.notify("Bạn đang sử dụng phiên bản mới nhất!")

    def on_copy_doctor_log_clicked(self, _):
        buffer = self.tv_doctor.get_buffer()
        start, end = buffer.get_bounds()
        text = buffer.get_text(start, end, True)
        if text.strip():
            display = Gdk.Display.get_default()
            if display:
                display.get_clipboard().set(text)
            self.notify("Đã sao chép báo cáo chẩn đoán vào bộ nhớ tạm")

    def on_run_doctor_clicked(self, _):
        self.btn_run_doctor.set_sensitive(False)
        self.spinner_doctor.set_visible(True)
        self.spinner_doctor.start()
        self.row_doctor.set_subtitle("Đang quét toàn diện các thành phần hệ thống...")
        self.img_doctor_status.set_from_icon_name("process-working-symbolic")

        def worker():
            out = ""
            try:
                candidates = [
                    pathlib.Path("/usr/libexec/ibus-engine-rustype"),
                    pathlib.Path("/usr/lib/ibus/ibus-engine-rustype"),
                    pathlib.Path.home()
                    / ".local"
                    / "lib"
                    / "rustype"
                    / "ibus-engine-rustype",
                    pathlib.Path.home() / ".local" / "bin" / "ibus-engine-rustype",
                    pathlib.Path("/usr/local/lib/rustype/ibus-engine-rustype"),
                    pathlib.Path(__file__).resolve().parent.parent
                    / "target"
                    / "release"
                    / "ibus-engine-rustype",
                    pathlib.Path(__file__).resolve().parent
                    / "target"
                    / "release"
                    / "ibus-engine-rustype",
                ]
                exe = shutil.which("ibus-engine-rustype")
                if not exe:
                    for c in candidates:
                        if c.exists():
                            exe = str(c)
                            break
                if not exe:
                    exe = "ibus-engine-rustype"
                res = subprocess.run(
                    [str(exe), "--doctor"], capture_output=True, text=True, timeout=8
                )
                out = res.stdout or res.stderr or "Không có phản hồi từ lệnh chẩn đoán."
            except Exception as e:
                out = f"Không thể chạy lệnh chẩn đoán: {e}"

            def update_ui():
                self.tv_doctor.get_buffer().set_text(out)
                self.spinner_doctor.stop()
                self.spinner_doctor.set_visible(False)
                self.btn_run_doctor.set_sensitive(True)
                self.expander_log.set_expanded(True)

                if "[✗]" in out:
                    self.row_doctor.set_subtitle(
                        "Phát hiện lỗi cần khắc phục (Xem chi tiết bên dưới)"
                    )
                    self.img_doctor_status.set_from_icon_name(
                        "dialog-error-symbolic"
                    )
                elif "[!]" in out:
                    self.row_doctor.set_subtitle(
                        "Bộ gõ hoạt động tốt (Có một vài cảnh báo cần lưu ý)"
                    )
                    self.img_doctor_status.set_from_icon_name(
                        "dialog-warning-symbolic"
                    )
                else:
                    self.row_doctor.set_subtitle(
                        "Tất cả thành phần hệ thống đang hoạt động hoàn hảo"
                    )
                    self.img_doctor_status.set_from_icon_name(
                        "emblem-ok-symbolic"
                    )

                self.notify("Đã hoàn thành chẩn đoán hệ thống")

            GLib.idle_add(update_ui)

        threading.Thread(target=worker, daemon=True).start()


def main():
    app = RustypeSettingsApp()
    return app.run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
