WORDS_FILE = CONFIG_DIR / "words"


def get_installed_version() -> str:
    """Detects version from installed ibus-engine-rustype or falls back to default."""
    candidates = [
        pathlib.Path("/usr/libexec/ibus-engine-rustype"),
        pathlib.Path("/usr/lib/ibus/ibus-engine-rustype"),
        pathlib.Path.home() / ".local" / "lib" / "rustype" / "ibus-engine-rustype",
        pathlib.Path.home() / ".local" / "bin" / "ibus-engine-rustype",
        pathlib.Path("/usr/local/lib/rustype/ibus-engine-rustype"),
        pathlib.Path(__file__).resolve().parent.parent
        / "target"
        / "release"
        / "ibus-engine-rustype",
        pathlib.Path(__file__).resolve().parent
        / "target"
        / "release"
        / "ibus-engine-rustype",
    ]
    exe = shutil.which("ibus-engine-rustype")
    if not exe:
        for c in candidates:
            if c.exists():
                exe = str(c)
                break
    if exe:
        try:
            res = subprocess.run(
                [str(exe), "--version"], capture_output=True, text=True, timeout=2
            )
            for token in res.stdout.split():
                if token and token[0].isdigit():
                    return token.strip()
        except Exception:
            pass
    return "0.1.0"


class ConfigManager:
    def __init__(self):
        self.mode = "auto"
        self.input_method = "telex"
        self.modern_orthography = False
        self.auto_restore_english = True
        self.remember_state_per_app = True
        self.enable_macro = False
        self.app_modes = {}
        self.macros = {}
        self.custom_words = []
        self.load()

    def load(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        if CONFIG_FILE.exists():
            section = ""
            for line in CONFIG_FILE.read_text(encoding="utf-8").splitlines():
                line = line.split("#")[0].strip()
                if not line:
                    continue
                if line.startswith("[") and line.endswith("]"):
                    section = line[1:-1].strip()
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k, v = k.strip().strip('"'), v.strip().strip('"')
                    if section == "app_modes":
                        self.app_modes[k] = v
                    elif section == "macros":
                        self.macros[k] = v
                    else:
                        if k == "mode":
                            self.mode = v
                        elif k == "input_method":
                            self.input_method = v
                        elif k == "modern_orthography":
                            self.modern_orthography = v.lower() in (
                                "true",
                                "1",
                                "yes",
                                "on",
                            )
                        elif k == "auto_restore_english":
                            self.auto_restore_english = v.lower() in (
                                "true",
                                "1",
                                "yes",
                                "on",
                            )
                        elif k == "remember_state_per_app":
                            self.remember_state_per_app = v.lower() in (
                                "true",
                                "1",
                                "yes",
                                "on",
                            )
                        elif k == "enable_macro":
                            self.enable_macro = v.lower() in ("true", "1", "yes", "on")
                        elif k == "custom_words":
                            self.custom_words = [
                                w.strip().strip('"') for w in v.split(",") if w.strip()
                            ]

        if MACRO_FILE.exists():
            for line in MACRO_FILE.read_text(encoding="utf-8").splitlines():
                line = line.split("#")[0].strip()
                if ":" in line:
                    k, v = line.split(":", 1)
                    if k.strip():
                        self.macros[k.strip()] = v.strip()

        if WORDS_FILE.exists():
            for line in WORDS_FILE.read_text(encoding="utf-8").splitlines():
                w = line.split("#")[0].strip()
                if w and w not in self.custom_words:
                    self.custom_words.append(w)

    def save(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        lines = [
            "# Rustype configuration",
            f"mode = {self.mode}",
            f"input_method = {self.input_method}",
            f"modern_orthography = {'true' if self.modern_orthography else 'false'}",
            f"auto_restore_english = {'true' if self.auto_restore_english else 'false'}",
            f"remember_state_per_app = {'true' if self.remember_state_per_app else 'false'}",
            f"enable_macro = {'true' if self.enable_macro else 'false'}",
            f"custom_words = {', '.join(self.custom_words)}",
            "",
            "[app_modes]",
        ]
        for app, m in sorted(self.app_modes.items()):
            lines.append(f'"{app}" = {m}')

        lines.append("")
        lines.append("[macros]")
        for k, v in sorted(self.macros.items()):
            lines.append(f'"{k}" = "{v}"')

        CONFIG_FILE.write_text("\n".join(lines) + "\n", encoding="utf-8")


class RustypeSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="dev.namtr.RustypeSettings",
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )
        self.cfg = ConfigManager()

    def do_activate(self):
        win = RustypePreferencesWindow(self, self.cfg)
        win.present()


