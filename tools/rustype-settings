ENGINE_NAME = "rustype-linux"


def find_engine():
    """Returns the path of rustype-linux: PATH first, then the known install locations."""
    exe = shutil.which(ENGINE_NAME)
    if exe:
        return exe
    candidates = [
        pathlib.Path("/usr/libexec/rustype-linux"),
        pathlib.Path.home() / ".local" / "lib" / "rustype" / "rustype-linux",
        pathlib.Path("/usr/local/libexec/rustype-linux"),
        pathlib.Path(__file__).resolve().parent.parent / "target" / "release" / ENGINE_NAME,
        pathlib.Path(__file__).resolve().parent / "target" / "release" / ENGINE_NAME,
    ]
    for c in candidates:
        if c.exists():
            return str(c)
    return None


def get_installed_version() -> str:
    """Detects the version from the installed rustype-linux or falls back to default."""
    exe = find_engine()
    if exe:
        try:
            res = subprocess.run(
                [str(exe), "--version"], capture_output=True, text=True, timeout=2
            )
            for token in res.stdout.split():
                if token and token[0].isdigit():
                    return token.strip()
        except Exception:
            pass
    return "0.2.2"


def strip_comment(line: str) -> str:
    """Drops a trailing '#' comment; a '#' inside double quotes is part of the value."""
    in_quotes = False
    for i, ch in enumerate(line):
        if ch == '"':
            in_quotes = not in_quotes
        elif ch == "#" and not in_quotes:
            return line[:i]
    return line


def drop_macro_lines(text: str, key: str) -> str:
    """Removes the lines whose macro key, parsed as load() does, equals key. Other lines stay."""
    out = []
    for line in text.splitlines(keepends=True):
        body = strip_comment(line.rstrip("\r\n")).strip()
        if ":" in body and body.split(":", 1)[0].strip() == key:
            continue
        out.append(line)
    return "".join(out)


def drop_word_lines(text: str, word: str) -> str:
    """Removes the lines whose word, parsed as load() does, equals word. Other lines stay."""
    out = []
    for line in text.splitlines(keepends=True):
        if strip_comment(line.rstrip("\r\n")).strip() == word:
            continue
        out.append(line)
    return "".join(out)


def rewrite_file(path: pathlib.Path, transform):
    """Applies transform to the text of an existing file. Writes a sibling temp file, then renames
    it over the target, following a symlink first, as the engine's config writer does. Returns None
    on success or when the file is missing, otherwise the error text."""
    if not path.exists():
        return None
    tmp = None
    try:
        target = path.resolve()
        text = target.read_text(encoding="utf-8")
        new = transform(text)
        if new == text:
            return None
        tmp = target.with_name(f".{target.name}.tmp")
        tmp.write_text(new, encoding="utf-8")
        os.replace(tmp, target)
    except (OSError, UnicodeError) as e:
        if tmp is not None:
            try:
                tmp.unlink()
            except OSError:
                pass
        return str(e)
    return None


BOOL_OPTIONS = (
    "modern_orthography",
    "auto_restore_english",
    "remember_state_per_app",
    "enable_macro",
    "free_tone_order",
    "simple_telex",
    "quick_telex",
    "auto_capitalize",
)


def read_text_or_none(path: pathlib.Path):
    """The text of path, or None when it cannot be read as UTF-8 text."""
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return None


def unquote(text: str) -> str:
    """Strips one pair of surrounding double quotes. Any other text is returned unchanged."""
    if len(text) >= 2 and text[0] == '"' and text[-1] == '"':
        return text[1:-1]
    return text


def parse_bool(text: str):
    """True or False for the spellings config.rs accepts, None for anything else."""
    v = text.lower()
    if v in ("true", "yes", "on", "1"):
        return True
    if v in ("false", "no", "off", "0"):
        return False
    return None


def normalize_mode(text: str) -> str:
    """The global display mode the engine uses: preedit or direct, anything else is auto."""
    v = text.lower()
    return v if v in ("preedit", "direct") else "auto"


TOP_KEYS = (
    "mode",
    "input_method",
    "modern_orthography",
    "auto_restore_english",
    "remember_state_per_app",
    "enable_macro",
    "custom_words",
    "free_tone_order",
    "toggle_shortcut",
    "simple_telex",
    "quick_telex",
    "auto_capitalize",
)


def config_key_value(line: str):
    """(key, value) of a key = value line, read the way load() reads it. None for other lines."""
    body = strip_comment(line).strip()
    if not body or (body.startswith("[") and body.endswith("]")) or "=" not in body:
        return None
    k, v = body.split("=", 1)
    return unquote(k.strip()), unquote(v.strip())


def section_name(line: str):
    """The name of a [section] header line, or None."""
    body = strip_comment(line).strip()
    if body.startswith("[") and body.endswith("]"):
        return body[1:-1].strip()
    return None


def _append_before_trailing_blank(lines, new):
    """Appends new lines after the content but before any trailing blank lines."""
    tail = []
    while lines and not lines[-1].strip():
        tail.insert(0, lines.pop())
    lines.extend(new)
    lines.extend(tail)
    return lines


def _entry_line(key: str, value: str, quote_value: bool) -> str:
    return f'"{key}" = "{value}"' if quote_value else f'"{key}" = {value}'


def merge_entries(body, mapping, quote_value: bool):
    """Brings one section body in line with mapping. Comments and blank lines stay, an unchanged
    entry keeps its original line, an entry missing from mapping is dropped, and new entries are
    added at the end."""
    out, seen = [], set()
    for line in body:
        kv = config_key_value(line)
        if kv is None:
            out.append(line)
            continue
        k, v = kv
        if k not in mapping or k in seen:
            continue
        seen.add(k)
        out.append(line if mapping[k] == v else _entry_line(k, mapping[k], quote_value))
    missing = [
        _entry_line(k, mapping[k], quote_value) for k in sorted(mapping) if k not in seen
    ]
    return _append_before_trailing_blank(out, missing)


def render_config(existing: str, top: dict, app_modes: dict, macros: dict) -> str:
    """The config text after a save. Managed top-level keys are set from top, app_modes and macros
    are merged as above, and every other line (unknown keys, unknown sections, comments) is kept."""
    lines = existing.splitlines() if existing.strip() else ["# Rustype configuration"]
    head, sections = [], []
    cur = head
    for line in lines:
        name = section_name(line)
        if name is None:
            cur.append(line)
        else:
            cur = []
            sections.append((name, line, cur))

    out, seen = [], set()
    for line in head:
        kv = config_key_value(line)
        if kv is not None and kv[0].startswith("app_mode."):
            continue  # the value lives in [app_modes] now
        if kv is not None and kv[0] in top:
            k, v = kv
            if k in seen:
                continue
            seen.add(k)
            out.append(line if v == top[k] else f"{k} = {top[k]}")
        else:
            out.append(line)
    out = _append_before_trailing_blank(
        out, [f"{k} = {top[k]}" for k in TOP_KEYS if k not in seen]
    )

    managed = {"app_modes": app_modes, "macros": macros}
    done = set()
    blocks = []
    for name, header, body in sections:
        if name in managed and name not in done:
            done.add(name)
            body = merge_entries(body, managed[name], quote_value=(name == "macros"))
        elif name not in managed:
            body = [l for l in body if not (config_key_value(l) or ("",))[0].startswith("app_mode.")]
        blocks.append((header, body))
    for name in ("app_modes", "macros"):
        if name not in done:
            blocks.append(
                (f"[{name}]", merge_entries([], managed[name], quote_value=(name == "macros")))
            )

    result = list(out)
    for header, body in blocks:
        if result and result[-1].strip():
            result.append("")
        result.append(header)
        result.extend(body)
    return "\n".join(result) + "\n"


def write_config_text(path: pathlib.Path, text: str):
    """Writes text beside the target and renames it over the target, following a symlink first."""
    target = path.resolve() if path.exists() else path
    tmp = target.with_name(f".{target.name}.tmp")
    try:
        tmp.write_text(text, encoding="utf-8")
        os.replace(tmp, target)
    except OSError:
        try:
            tmp.unlink()
        except OSError:
            pass
        raise


def _bool_text(value: bool) -> str:
    return "true" if value else "false"


class ConfigManager:
    def __init__(self):
        self.mode = "auto"
        self.input_method = "telex"
        self.modern_orthography = False
        self.auto_restore_english = True
        self.remember_state_per_app = True
        self.enable_macro = False
        self.free_tone_order = True
        self.toggle_shortcut = "ctrl_shift"
        self.simple_telex = False
        self.quick_telex = False
        self.auto_capitalize = False
        self.app_modes = {}
        self.macros = {}
        self.custom_words = []
        self.load()

    def load(self):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        text = read_text_or_none(CONFIG_FILE) if CONFIG_FILE.exists() else None
        if text is not None:
            section = ""
            for line in text.splitlines():
                line = strip_comment(line).strip()
                if not line:
                    continue
                if line.startswith("[") and line.endswith("]"):
                    section = line[1:-1].strip()
                    continue
                if "=" in line:
                    k, v = line.split("=", 1)
                    k, v = unquote(k.strip()), unquote(v.strip())
                    if section == "app_modes":
                        self.app_modes[k] = v
                    elif section == "macros":
                        self.macros[k] = v
                    elif k.startswith("app_mode."):
                        # The engine reads this form too and lowercases the app name (config.rs:333-336).
                        app = k[len("app_mode."):].strip('"')
                        self.app_modes[app.lower()] = v
                    elif k == "mode":
                        self.mode = normalize_mode(v)
                    elif k == "input_method":
                        self.input_method = "vni" if v.lower() == "vni" else "telex"
                    elif k == "toggle_shortcut":
                        self.toggle_shortcut = v.lower()
                    elif k == "custom_words":
                        self.custom_words = [
                            w.strip().strip('"') for w in v.split(",") if w.strip()
                        ]
                    elif k in BOOL_OPTIONS:
                        flag = parse_bool(v)
                        if flag is not None:  # any other value keeps the default, as config.rs does
                            setattr(self, k, flag)

        if MACRO_FILE.exists():
            for line in (read_text_or_none(MACRO_FILE) or "").splitlines():
                line = strip_comment(line).strip()
                if ":" in line:
                    k, v = line.split(":", 1)
                    if k.strip() and v.strip():  # config.rs skips an empty key or value
                        self.macros[k.strip()] = v.strip()

        if WORDS_FILE.exists():
            for line in (read_text_or_none(WORDS_FILE) or "").splitlines():
                w = strip_comment(line).strip()
                if w and w not in self.custom_words:
                    self.custom_words.append(w)

    def save(self):
        """Writes the config. Keys and sections this app does not manage are kept as they are."""
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        existing = ""
        dest = CONFIG_FILE
        if CONFIG_FILE.exists():
            dest = CONFIG_FILE.resolve()
            text = read_text_or_none(dest)
            if text is None:
                # Not UTF-8: move the bytes aside rather than overwrite them, then write fresh.
                os.replace(dest, dest.with_name(dest.name + ".invalid"))
            else:
                existing = text
        top = {
            "mode": self.mode,
            "input_method": self.input_method,
            "modern_orthography": _bool_text(self.modern_orthography),
            "auto_restore_english": _bool_text(self.auto_restore_english),
            "remember_state_per_app": _bool_text(self.remember_state_per_app),
            "enable_macro": _bool_text(self.enable_macro),
            # A word with a comma cannot be stored in this list; it stays in the words file.
            "custom_words": ", ".join(w for w in self.custom_words if "," not in w),
            "free_tone_order": _bool_text(self.free_tone_order),
            "toggle_shortcut": self.toggle_shortcut,
            "simple_telex": _bool_text(self.simple_telex),
            "quick_telex": _bool_text(self.quick_telex),
            "auto_capitalize": _bool_text(self.auto_capitalize),
        }
        write_config_text(dest, render_config(existing, top, self.app_modes, self.macros))


class RustypeSettingsApp(Adw.Application):
    def __init__(self):
        super().__init__(
            application_id="dev.namtr.RustypeSettings",
            flags=Gio.ApplicationFlags.FLAGS_NONE,
        )
        self.cfg = ConfigManager()

    def do_activate(self):
        win = RustypePreferencesWindow(self, self.cfg)
        win.present()


